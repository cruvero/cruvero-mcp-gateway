{
  "name": "cruvero-mcp-gateway",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "devcontainer",
  "runServices": ["certs", "postgres", "keycloak", "devcontainer", "mock-backend"],
  "workspaceFolder": "/workspaces/cruvero-mcp-gateway",
  "remoteUser": "vscode",
  "forwardPorts": [8443, 8444, 9090],
  "customizations": {
    "vscode": {
      "settings": {
        "go.useLanguageServer": true,
        "go.toolsManagement.checkForUpdates": "local",
        "yaml.format.enable": true
      },
      "extensions": [
        "golang.Go",
        "redhat.vscode-yaml",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "tim-koehler.helm-intellisense"
      ]
    }
  },
  "postCreateCommand": "bash -lc 'set -euo pipefail; scripts/dev-setup.sh'"
}
